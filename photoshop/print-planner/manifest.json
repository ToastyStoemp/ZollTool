{
  "manifestVersion": 4,
  "id": "com.getupgames.zolltool.printplanner",
  "name": "ZollTool Print Planner",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "22.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "printPlanner",
      "label": { "default": "Print Planner" },
      "minimumSize": { "width": 230, "height": 320 },
      "maximumSize": { "width": 2400, "height": 2400 },
      "preferredDockedSize": { "width": 340, "height": 600 },
      "preferredFloatingSize": { "width": 380, "height": 660 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": ["all"]
    }
  }
}
